# Copy to .env.local for local development (never commit .env.local).
# On Vercel, configure only the default Tutor service in Project Settings.
# Personal connections are available only with the native local backend below.

# Public demo / free testing mode (recommended for Vercel public deployment)
AI_TUTOR_MOCK=true

# Optional live DEFAULT Tutor service — server-side only; do NOT use VITE_ prefix.
# Personal provider keys belong in the verified local settings form, not this file.
# OPENAI_API_KEY=sk-...

# Optional: local API dev server port (default 3001)
# API_PORT=3001

# Personal connections: explicit native local backend opt-in (default false).
# Keep AI_TUTOR_MOCK=true above for an offline default Tutor/demo.
# T_LAB_PERSONAL_TUTOR=true

# Optional replacement allowlist for non-default frontend ports. Exact HTTP
# 127.0.0.1 or localhost origins with explicit ports; comma-separated, no wildcards.
# Defaults cover both hosts on ports 5173 (dev) and 4173 (preview).
# T_LAB_LOCAL_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
# See docs/tutor/LOCAL_CONNECTIONS.md for Windows setup and data destinations.
